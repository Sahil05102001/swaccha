rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================
    // Helper Functions
    // ==========================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    // Full address validation (mirrors the AddressForm rules).
    // The pin range is a rough box around the 40 km delivery area; the
    // backend does the exact distance check when an order is placed.
    function validAddress(data) {
      return data.keys().hasOnly([
          'fullName', 'phoneNumber', 'addressLine1', 'addressLine2',
          'city', 'state', 'postalCode', 'country', 'isDefault',
          'latitude', 'longitude', 'locationAccuracy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'fullName', 'phoneNumber', 'addressLine1',
          'city', 'state', 'postalCode', 'country', 'isDefault',
          'latitude', 'longitude'
        ])
        && data.fullName is string
        && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.phoneNumber is string
        && data.phoneNumber.matches('^[6-9][0-9]{9}$')
        && data.addressLine1 is string
        && data.addressLine1.size() >= 5 && data.addressLine1.size() <= 200
        && (
          !('addressLine2' in data)
          || (data.addressLine2 is string && data.addressLine2.size() <= 200)
        )
        && data.city == 'Nagpur'
        && data.state == 'Maharashtra'
        && data.postalCode is string
        && data.postalCode.matches('^[1-9][0-9]{5}$')
        && data.country is string
        && data.country.size() >= 1 && data.country.size() <= 100
        && data.isDefault is bool
        && data.latitude is number
        && data.latitude >= 20.78 && data.latitude <= 21.51
        && data.longitude is number
        && data.longitude >= 78.72 && data.longitude <= 79.50
        && (
          !('locationAccuracy' in data)
          || (
            data.locationAccuracy is number
            && data.locationAccuracy >= 0
            && data.locationAccuracy <= 100000
          )
        );
    }

    // "Set as default" and delete-takeover only flip isDefault. They must
    // keep working even for old addresses saved before these rules existed.
    function onlyDefaultFlagChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isDefault', 'updatedAt']);
    }

    // ---- Reviews ----

    // Email must be verified (Google sign-ins count as verified).
    function isVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function ratingSumOf(data) {
      return 'ratingSum' in data ? data.ratingSum : 0;
    }

    function ratingCountOf(data) {
      return 'ratingCount' in data ? data.ratingCount : 0;
    }

    function validReviewContent(data) {
      return data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.title is string
        && data.title.size() >= 1 && data.title.size() <= 100
        && data.body is string
        && data.body.size() >= 10 && data.body.size() <= 1000;
    }

    // A customer may touch only ratingSum / ratingCount on a product, and
    // only in the same batch as their own review change, with exact math.
    function reviewCounterUpdate(productId) {
      let rp = /databases/$(database)/documents/reviews/$(productId + '_' + request.auth.uid);
      let sumDelta = ratingSumOf(request.resource.data) - ratingSumOf(resource.data);
      let countDelta = ratingCountOf(request.resource.data) - ratingCountOf(resource.data);
      return isVerified()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ratingSum', 'ratingCount'])
        && (
          // new review
          (!exists(rp) && existsAfter(rp)
            && countDelta == 1
            && sumDelta == getAfter(rp).data.rating)
          // edited review
          || (exists(rp) && existsAfter(rp)
            && countDelta == 0
            && sumDelta == getAfter(rp).data.rating - get(rp).data.rating)
          // deleted by the owner
          || (exists(rp) && !existsAfter(rp)
            && countDelta == -1
            && sumDelta == -get(rp).data.rating)
        );
    }

    // ==========================
    // Stock Movements (written by the backend only)
    // ==========================

    match /stockMovements/{movementId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ==========================
    // Users
    // ==========================

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == "customer";

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
        );

      allow delete: if false;

      // Addresses
      match /addresses/{addressId} {
        allow read, delete: if isOwner(userId);

        allow create: if isOwner(userId)
          && validAddress(request.resource.data);

        allow update: if isOwner(userId)
          && (
            onlyDefaultFlagChanged()
            || validAddress(request.resource.data)
          );
      }

      // Cart
      match /cart/{cartItemId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Wishlist
      match /wishlist/{productId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Nested orders: backend writes only
      match /orders/{orderId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // ==========================
    // Top-Level Orders
    // ==========================

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // Orders are created, paid and updated only by the backend (Admin SDK).
      // The backend enforces the COD cash confirmation, the mandatory
      // shipping details and the allowed status steps.
      allow create, update, delete: if false;
    }

    // ==========================
    // Products
    // ==========================

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || reviewCounterUpdate(productId);
    }

    // ==========================
    // Reviews
    // ==========================

    match /reviews/{reviewId} {
      allow read: if true;

      // One review per user per product (id = productId_uid), verified
      // email only, and only for a delivered order that belongs to them.
      allow create: if isVerified()
        && request.resource.data.keys().hasOnly([
          'productId', 'productName', 'orderId', 'userId', 'userName',
          'rating', 'title', 'body', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'productId', 'productName', 'orderId', 'userId', 'userName',
          'rating', 'title', 'body', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && reviewId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 200
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 100
        && request.resource.data.createdAt == request.time
        && validReviewContent(request.resource.data)
        && request.resource.data.orderId is string
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.orderStatus == 'delivered';

      allow update: if
        // author edits their own review
        (
          isVerified()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rating', 'title', 'body', 'editedAt'])
          && request.resource.data.editedAt == request.time
          && validReviewContent(request.resource.data)
        )
        // admin adds, edits or removes the reply (nothing else)
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['adminReply'])
          && (
            !('adminReply' in request.resource.data)
            || (
              request.resource.data.adminReply is map
              && request.resource.data.adminReply.text is string
              && request.resource.data.adminReply.text.size() >= 1
              && request.resource.data.adminReply.text.size() <= 1000
              && request.resource.data.adminReply.createdAt is timestamp
            )
          )
        );

      allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }

    // ==========================
    // Categories
    // ==========================

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // Category Circles
    // ==========================

    match /categoryCircles/{categoryCircleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // Store Settings
    // ==========================

    match /storeSettings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // CMS
    // ==========================

    match /cms/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // Hero Banners
    // ==========================

    match /heroBanners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // Best Sellers
    // ==========================

    match /bestSellers/{bestSellerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // Offer Zone Products
    // ==========================

    match /offerZoneProducts/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // Featured Products
    // ==========================

    match /featuredProducts/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // Advertisement Banner
    // ==========================

    match /adBanner/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // Homepage Videos
    // ==========================

    match /homepageVideos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================
    // Brand Statement
    // ==========================

    match /brandStatement/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}